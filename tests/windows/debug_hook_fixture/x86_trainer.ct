<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID><Description>"Owned x86 hook and provider"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(OwnedX86Entry,NativeDebugHookFixture-x86.exe,8B 44 24 04 83 C0 01 90 90 C2 04 00)
assert(OwnedX86Entry,8B 44 24 04 83 C0 01 90 90)
alloc(OwnedX86Cave,$1000,OwnedX86Entry)
label(OwnedX86Return,OwnedX86Data,OwnedX86Guard)
OwnedX86Cave:
 pushfd
 pushad
 popad
 popfd
 mov eax,[esp+4]
 add eax,#100
 jmp OwnedX86Return
OwnedX86Data:
 dd #1234
OwnedX86Guard:
 dd $DEADBEEF
OwnedX86Entry:
 jmp OwnedX86Cave
 nop 4
OwnedX86Return:
registersymbol(OwnedX86Entry,OwnedX86Data,OwnedX86Guard)
[DISABLE]
OwnedX86Entry:
 db 8B 44 24 04 83 C0 01 90 90
unregistersymbol(*)
dealloc(*)
</AssemblerScript>
    </CheatEntry>
    <CheatEntry><ID>2</ID><Description>"Owned x86 literal value"</Description><VariableType>4 Bytes</VariableType><Address>OwnedX86Data</Address></CheatEntry>
  </CheatEntries>
</CheatTable>

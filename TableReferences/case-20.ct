    <CheatEntry>
      <ID>2</ID>
      <Description>"phase split inside explicit lua block"</Description>
      <Color>0075EA</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
local synth20_preamble = 1
[ENABLE]
getMemoryRecordByID(4).Active = true
{$asm}
ct2synth20.exe+90:
  db 90
[DISABLE]
getMemoryRecordByID(4).Active = false
{$asm}
ct2synth20.exe+90:
  db 90</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>3</ID>

<CheatTable CheatEngineTableVersion="46">
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"Toggle scripts"</Description>
      <Color>0075EA</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">[ENABLE]
{$lua}
synchronize(function()
  getLuaEngine().menuItem5.doClick()
  getLuaEngine().Close()
end)
getMemoryRecordByID(2).Active = true
getMemoryRecordByID(6).Active = true
getMemoryRecordByID(8).Active = true
getMemoryRecordByID(11).Active = true
getMemoryRecordByID(14).Active = true
getMemoryRecordByID(25).Active = true
addressList.refresh()
{$asm}
[DISABLE]
{$lua}
getMemoryRecordByID(2).Active = false
getMemoryRecordByID(6).Active = false
getMemoryRecordByID(8).Active = false
getMemoryRecordByID(11).Active = false
getMemoryRecordByID(14).Active = false
getMemoryRecordByID(25).Active = false
addressList.refresh()
{$asm}</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>1</ID>
      <Description>"Get synth.Manager"</Description>
      <Color>0075EA</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(synthMgrCave,64)

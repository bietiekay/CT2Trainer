  <LuaScript>
-- CT2Trainer clean-room corpus: synthetic table bootstrap for re2.CT.
-- Installs the reviewed Nth-AOB helper and registers the synthetic
-- time custom types used by the three custom-type records.

registerCustomTypeAutoAssembler("synHrs", "1")
registerCustomTypeAutoAssembler("synMins", "2")
registerCustomTypeAutoAssembler("synSecs", "1")

local SYN_BOOTSTRAP_DONE = false

function synBootstrapStatus()
  return SYN_BOOTSTRAP_DONE
end

function lua_aobscan(name,module,bytes,index)
  local hits = {}
  if module and module ~= "" then
    hits = aobscanmodule(name, module, bytes)
  else
    hits = aobscan(name, bytes)
  end
  if hits and index and hits[index] then
    return hits[index]
  end
  return nil
end

SYN_BOOTSTRAP_DONE = true
  </LuaScript>

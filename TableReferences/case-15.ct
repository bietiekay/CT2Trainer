    <CheatEntry>
      <ID>13</ID>
      <Description>"$process AOB scan (WP-19)</Description>
      <Color>FF8080</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(synProcScan, $process, 89 48 08)
synProcScan:
assert(synProcScan, 89 48 08)
db 90
[DISABLE]
synProcScan:
assert(synProcScan, 90)
db 89</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>14</ID>
      <Description>"globalalloc with @@: cursor (WP-20)</Description>
      <Color>FF8080</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
label(synthDone)
globalalloc(synthShared,8)
synthShared:
dd #11
@@:
dd #22
alloc(synthCave,1000)
synthCave:
mov rcx,synthShared
mov eax,[rcx]
jmp synthDone
ct2synth15.exe+200:
jmp synthCave
synthDone:
[DISABLE]
ct2synth15.exe+200:
db B8 01 00 00 00
dealloc(synthCave)
dealloc(synthShared)</AssemblerScript>
    </CheatEntry>
